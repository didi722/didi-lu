{
  "appId": "com.didilucabattles.app",
  "appName": "Sant'Alvise League",
  "webDir": "www",
  "server": {
    "url": "https://didi722.github.io/didi-lu/",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "SantAlviseApp",
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
